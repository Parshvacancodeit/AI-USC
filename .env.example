# Copy to .env.local (never commit). Same values go in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ADMIN_PASSCODE=

# Office loop email (demo): all mail goes to DEMO_OFFICE_INBOX, tagged [Department]
RESEND_API_KEY=
EMAIL_FROM=Ripple <onboarding@resend.dev>
DEMO_OFFICE_INBOX=
APP_URL=

# Demo: every office response deadline = this many minutes (unset in production; e.g. 2 for a live demo)
NEXT_PUBLIC_SLA_DEMO_MINUTES=
